# Target network: "sepolia" (default) or "anvil" (local Foundry node)
VITE_CHAIN=sepolia

# Addresses deployed on the chosen network (do NOT use Anvil addresses on Sepolia)
VITE_AUTHORIZATION_ADDRESS=0x...
VITE_REGISTRY_ADDRESS=0x...

# Sepolia RPC URL (Alchemy, Infura, etc.). It is a read-access key, not a private key.
VITE_SEPOLIA_RPC_URL=

# WalletConnect (optional): free projectId from https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Block at which the Registry was deployed (speeds up the event search). Optional.
VITE_DEPLOY_BLOCK=0
