# Red de destino: "sepolia" (por defecto) o "anvil" (nodo local de Foundry)
VITE_CHAIN=sepolia

# Direcciones desplegadas en la red elegida (NO usar las de Anvil en Sepolia)
VITE_AUTHORIZATION_ADDRESS=0x...
VITE_REGISTRY_ADDRESS=0x...

# RPC público de Sepolia (Alchemy, Infura, etc.). Es una clave de lectura, no una private key.
VITE_SEPOLIA_RPC_URL=

# WalletConnect (opcional): projectId gratuito de https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Bloque en el que se desplegó el Registry (acelera la búsqueda de eventos). Opcional.
VITE_DEPLOY_BLOCK=0
