# Copy this file to .env and fill in the values for the network you use.
# Keep actual private keys and sensitive RPC credentials in the ignored .env file.
# Frontend settings are documented separately in frontend/.env.example.

# Local Anvil account keys: the authorization owner and technical director.
ANVIL_OWNER_PK=
DIRECTOR_PK=

# Contract addresses from the same local Anvil deployment.
AUTHORIZATION_ADDRESS=
REGISTRY_ADDRESS=

# Sepolia RPC endpoint and deployment account key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=

# Authorization contract address obtained after deploying it on Sepolia.
SEPOLIA_AUTHORIZATION_ADDRESS=
